<%
  var total = omr(booking.price.total);
  var other = lang === 'ar' ? 'en' : 'ar';
%><!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %></title>
  <meta name="theme-color" content="#FFFFFF">
  <link rel="icon" type="image/png" href="<%= site.payMerchant.logo %>">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="page-pay">
<main class="pay" data-pay data-ref="<%= booking.ref %>">
  <!-- left: merchant + amount -->
  <section class="pay__side">
    <header class="pay__merchant">
      <img class="pay__logo" src="<%= site.payMerchant.logo %>" alt="" width="64" height="64">
      <div>
        <strong><%= site.payMerchant.name %></strong>
        <span><%= L(site.payMerchant.address) %></span>
      </div>
      <% if (site.payMerchant.phone) { %><a class="pay__phone" href="tel:<%= site.payMerchant.phone.replace(/\s/g,'') %>" dir="ltr"><%- icon('phone', 22) %><%= site.payMerchant.phone %></a><% } %>
    </header>

    <div class="pay__amount">
      <p><%= t('pay.total') %></p>
      <strong><span class="pay__cur">OMR</span><span dir="ltr"><%= total %></span></strong>
    </div>


    <footer class="pay__foot">
      <span class="pay__by" lang="en" dir="ltr">Powered by <b class="pay__paymob">paymob<sup>™</sup></b></span>
      <span class="pay__secure"><%- icon('lock', 22) %><%= t('pay.secure') %></span>
    </footer>
  </section>

  <!-- right: card form -->
  <section class="pay__main">
    <div class="pay__head">
      <h1><%= t('pay.title') %></h1>
      <label class="pay__lang">
        <select data-pay-lang aria-label="Language">
          <option value="<%= lang %>" selected><%= lang === 'ar' ? 'العربية' : 'English' %></option>
          <option value="<%= other %>" data-href="<%= altUrl %>"><%= other === 'ar' ? 'العربية' : 'English' %></option>
        </select><%- icon('chevron-down', 18) %>
      </label>
    </div>

    <% if (payment) { %>
      <div class="pay__done">
        <span class="done-mark"><%- icon('check', 28) %></span>
        <h2 class="h3"><%= t('pay.paidTitle') %></h2>
        <p class="muted"><%= t('pay.paidText', { ref: booking.ref, date: payment.paidAt.slice(0, 10) }) %></p>
        <a class="btn btn--line" href="<%= url('/') %>"><%= t('pay.back') %></a>
      </div>
    <% } else { %>
    <form class="pay__form" novalidate data-pay-form autocomplete="off">
      <p class="pay__label"><%= t('pay.method') %></p>
      <div class="pay__method is-on" role="radio" aria-checked="true" tabindex="0"><%- icon('credit-card', 28) %><span><%= t('pay.card') %></span></div>

      <p class="pay__label"><%= t('pay.cardInfo') %></p>
      <div class="pay__card">
        <div class="pay__num">
          <input name="number" inputmode="numeric" placeholder="1234 1234 1234 1234" maxlength="23" dir="ltr" aria-label="Card number" autocomplete="off">
          <span class="pay__brands" data-brands>
            <span class="brand brand--mc" data-brand="mastercard" title="Mastercard"><i></i><i></i></span>
            <span class="brand brand--visa" data-brand="visa" title="Visa">VISA</span>
            <span class="brand brand--amex" data-brand="amex" title="American Express">AMEX</span>
          </span>
        </div>
        <input name="exp" inputmode="numeric" placeholder="MM/YY" maxlength="5" dir="ltr" aria-label="MM/YY" autocomplete="off">
        <div class="pay__cvv">
          <input name="cvv" inputmode="numeric" placeholder="CVV" maxlength="4" dir="ltr" aria-label="CVV" autocomplete="off">
          <span title="3–4 digits on the back of the card"><%- icon('circle-help', 17) %></span>
        </div>
      </div>

      <label class="pay__label" for="pay-holder"><%= t('pay.holder') %></label>
      <input class="pay__input" id="pay-holder" name="holder" placeholder="<%= t('pay.holderPh') %>" autocomplete="off">

      <label class="pay__check"><input type="checkbox" name="save"> <span><%= t('pay.save') %></span></label>

      <div class="pay__spacer"></div>
      <p class="pay__demo"><%= t('pay.demo') %></p>
      <p class="form-error" data-pay-error hidden></p>
      <button class="pay__btn" type="submit" disabled data-pay-btn><%= t('pay.pay') %> <span dir="ltr">OMR <%= total %></span></button>
    </form>
    <div class="pay__done" data-pay-done hidden>
      <span class="done-mark"><%- icon('check', 28) %></span>
      <h2 class="h3"><%= t('pay.doneTitle') %></h2>
      <p class="muted"><%= t('pay.doneText', { ref: booking.ref }) %></p>
      <a class="btn btn--solid" href="<%= url('/') %>"><%= t('pay.back') %></a>
    </div>
    <% } %>
  </section>
</main>
<script type="application/json" id="pay-i18n"><%- JSON.stringify({ fill: t('pay.fill'), error: t('pay.error') }).replace(/</g, '\\u003c') %></script>
<script src="/js/pay.js" defer></script>
</body>
</html>
