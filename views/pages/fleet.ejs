<%- include('../partials/head', { overHero: true }) %>
<%- include('../partials/page-hero', { heroImg: 'sclass-street', heroEyebrow: t('fleet.eyebrow'), heroEyebrowLang: '', heroTitle: t('fleet.title'), heroLead: t('fleet.lead'),
  heroActions: '<a class="btn btn--light" href="' + url('/chauffeur') + '">' + t('fleet.chauffeurCta') + '</a><a class="btn btn--ghost-light" href="' + url('/rental') + '">' + t('fleet.rentalCta') + '</a>' }) %>

<section class="section">
  <div class="wrap">
    <%- include('../partials/section-head', { eb: t('fleet.withChauffeur'), ttl: t('fleet.transferClasses'), sub: '', action: '' }) %>
    <div class="grid3">
      <% catalog.transferClasses.forEach(function(c, i){ %><%- include('../partials/class-card', { c: c, i: i }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section--stone">
  <div class="wrap">
    <%- include('../partials/section-head', { eb: t('fleet.selfDrive'), ttl: t('fleet.rentalCars'), sub: '', action: '' }) %>
    <div class="hscroll" data-hscroll>
      <% catalog.rentalCars.forEach(function(c, i){ %>
        <a class="rcard reveal" style="--d:<%= i %>" href="<%= url('/rental') %>?car=<%= c.id %>">
          <span class="rcard__img"><img src="/img/<%= c.img %>-sm.webp" alt="<%= c.name %>" loading="lazy"></span>
          <span class="rcard__row"><strong><%= c.name %></strong><span class="mono small">OMR <%= omr(c.perDay) %> / <%= t('common.day') %></span></span>
          <span class="muted small"><%= L(c.type) %> · <%= c.year %> · <%= c.seats %> <%= t('common.seats') %> · <%= c.bags %> <%= t('common.bags') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap mosaic">
    <figure class="clipreveal m1"><img src="/img/chauffeur-door-sm.webp" alt="" loading="lazy"></figure>
    <figure class="clipreveal m2"><img src="/img/bentley-detail-sm.webp" alt="" loading="lazy"></figure>
    <figure class="clipreveal m3"><img src="/img/vclass-sm.webp" alt="" loading="lazy"></figure>
    <figure class="clipreveal m4"><img src="/img/van-chauffeur-sm.webp" alt="" loading="lazy"></figure>
  </div>
</section>
<%- include('../partials/foot') %>
