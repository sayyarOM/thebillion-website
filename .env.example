PORT=3000
NODE_ENV=production
SITE_URL=https://thebillion.om
# Secret token for the control dashboard to read bookings: GET /api/admin/bookings  (header: Authorization: Bearer <token>)
ADMIN_TOKEN=change-me
# Maps (server-side only, never sent to the browser). Empty = free OpenStreetMap fallback.
# Google key with Places API + Geocoding API (place search + addresses)
GOOGLE_MAPS_KEY=
# Mapbox token for the map tiles
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/streets-v12
